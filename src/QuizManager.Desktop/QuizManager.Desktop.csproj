<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuizManager.Desktop</RootNamespace>
    <AssemblyName>QuizManager</AssemblyName>
    <ApplicationTitle>Factburst Quiz Manager</ApplicationTitle>
    <StartupObject>QuizManager.Desktop.Program</StartupObject>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuizManager.Core\QuizManager.Core.csproj" />
    <ProjectReference Include="..\QuizManager.Infrastructure\QuizManager.Infrastructure.csproj" />
    <ProjectReference Include="..\QuizManager.Rendering\QuizManager.Rendering.csproj" />
  </ItemGroup>
</Project>
