<Window x:Class="QuizManager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Factburst Quiz Manager" Width="1200" Height="760" MinWidth="900" MinHeight="600" Background="{StaticResource PageBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Factburst Quiz Manager" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/><TextBlock Text="V2 • full quiz creation, rendering and publishing workspace" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource SecondaryText}"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="VersionText" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource SecondaryText}"/><Button Content="Import Legacy Database" Padding="16,9" Margin="0,0,8,0" Click="ImportLegacy_Click"/><Button x:Name="UpdateButton" Content="Check for Updates" Padding="16,9" Click="Update_Click"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="14"><StackPanel>
                <Button Content="Dashboard" Height="44" Margin="0,0,0,8" Click="Dashboard_Click"/><Button Content="Question Library" Height="44" Margin="0,0,0,8" Click="QuestionLibrary_Click"/><Button Content="Quiz Projects" Height="44" Margin="0,0,0,8" Click="QuizProjects_Click"/><Button Content="Rendering" Height="44" Margin="0,0,0,8" Click="Rendering_Click"/><Button Content="Publishing" Height="44" Margin="0,0,0,8" Click="Publishing_Click"/><Button Content="Automation" Height="44" Click="Automation_Click"/>
            </StackPanel></Border>
            <Border Grid.Column="1" Margin="20,0,0,0" Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="28"><StackPanel>
                <TextBlock Text="Create a quiz" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/><TextBlock Text="Build reusable quiz projects, select the category and question count, generate a rotated quiz, then render it into a video." Margin="0,8,0,24" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal"><Button Content="Open Dashboard" Width="170" Height="44" Click="Dashboard_Click"/><Button Content="Open Question Library" Width="220" Height="44" Margin="10,0,0,0" Click="QuestionLibrary_Click"/><Button Content="Open Quiz Projects" Width="180" Height="44" Margin="10,0,0,0" Click="QuizProjects_Click"/><Button Content="Open Rendering" Width="150" Height="44" Margin="10,0,0,0" Click="Rendering_Click"/><Button Content="Open Publishing" Width="160" Height="44" Margin="10,0,0,0" Click="Publishing_Click"/><Button Content="Open Automation" Width="170" Height="44" Margin="10,0,0,0" Click="Automation_Click"/></StackPanel>
                <Border Margin="0,24,0,0" Padding="18" CornerRadius="10" Background="#263449"><StackPanel><TextBlock Text="Video rendering" Foreground="{StaticResource PrimaryText}" FontSize="17"/><TextBlock Text="Generate real 1280×720 MP4 output from a project quiz using the dedicated rendering worker and FFmpeg." Margin="0,8,0,12" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/><Button Content="Render a Project" Width="180" Height="40" HorizontalAlignment="Left" Click="Rendering_Click"/></StackPanel></Border>
                <Border Margin="0,24,0,0" Padding="18" CornerRadius="10" Background="#263449"><StackPanel><TextBlock Text="Publishing" Foreground="{StaticResource PrimaryText}" FontSize="17"/><TextBlock Text="Select a rendered MP4, add title, description and thumbnail, then queue it for YouTube publishing with a durable local history." Margin="0,8,0,12" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/><Button Content="Open Publishing" Width="180" Height="40" HorizontalAlignment="Left" Click="Publishing_Click"/></StackPanel></Border>
                <Border Margin="0,24,0,0" Padding="18" CornerRadius="10" Background="#263449"><StackPanel><TextBlock Text="Automation" Foreground="{StaticResource PrimaryText}" FontSize="17"/><TextBlock Text="Set a daily or weekly production time and save the plan outside the installed application so it survives updates." Margin="0,8,0,12" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/><Button Content="Configure Automation" Width="200" Height="40" HorizontalAlignment="Left" Click="Automation_Click"/></StackPanel></Border>
                <Border Margin="0,24,0,0" Padding="18" CornerRadius="10" Background="#263449"><StackPanel><TextBlock Text="Bring your existing FactVault Manager data" Foreground="{StaticResource PrimaryText}" FontSize="17"/><TextBlock Text="Import the original factvault.db without overwriting your current V2 database. Legacy tables remain preserved and the question library is migrated." Margin="0,8,0,12" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/><Button Content="Import Existing Database" Width="220" Height="40" HorizontalAlignment="Left" Click="ImportLegacy_Click"/></StackPanel></Border>
            </StackPanel></Border>
        </Grid>
    </Grid>
</Window>