<Window x:Class="QuizManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factburst Quiz Manager"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Factburst Quiz Manager" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                <TextBlock Text="V2 • responsive quiz creation workspace" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource SecondaryText}" />
                <Button x:Name="UpdateButton" Content="Check for Updates" Padding="16,9" Click="Update_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="14">
                <StackPanel>
                    <Button Content="Dashboard" Height="44" Margin="0,0,0,8" />
                    <Button Content="Question Library" Height="44" Margin="0,0,0,8" Click="QuestionLibrary_Click" />
                    <Button Content="Quiz Projects" Height="44" Margin="0,0,0,8" Click="QuizProjects_Click" />
                    <Button Content="Rendering" Height="44" Margin="0,0,0,8" />
                    <Button Content="Publishing" Height="44" Margin="0,0,0,8" />
                    <Button Content="Automation" Height="44" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="20,0,0,0" Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="28">
                <StackPanel>
                    <TextBlock Text="Create a quiz" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                    <TextBlock Text="Create reusable quiz projects, select the category and question count, then generate a rotated quiz from your enabled question library." Margin="0,8,0,24" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Question Library" Width="220" Height="44" HorizontalAlignment="Left" Click="QuestionLibrary_Click" />
                        <Button Content="Open Quiz Projects" Width="180" Height="44" Margin="10,0,0,0" HorizontalAlignment="Left" Click="QuizProjects_Click" />
                    </StackPanel>
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,10,0" Padding="18" CornerRadius="10" Background="#263449">
                            <StackPanel>
                                <TextBlock Text="Question Library" Foreground="{StaticResource PrimaryText}" FontSize="17" />
                                <TextBlock Text="SQLite-backed questions, categories, enabled state and usage tracking." Margin="0,8,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0" Padding="18" CornerRadius="10" Background="#263449">
                            <StackPanel>
                                <TextBlock Text="Quiz Projects" Foreground="{StaticResource PrimaryText}" FontSize="17" />
                                <TextBlock Text="Save quiz definitions and generate a repeatable question set using the rotation rules." Margin="0,8,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
