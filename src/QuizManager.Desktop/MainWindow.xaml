<Window x:Class="QuizManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factburst Quiz Manager"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Factburst Quiz Manager" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
            <TextBlock Text="V2 • responsive quiz creation workspace" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource SecondaryText}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="14">
                <StackPanel>
                    <Button Content="Dashboard" Height="44" Margin="0,0,0,8" />
                    <Button Content="Question Library" Height="44" Margin="0,0,0,8" />
                    <Button Content="Quiz Projects" Height="44" Margin="0,0,0,8" />
                    <Button Content="Rendering" Height="44" Margin="0,0,0,8" />
                    <Button Content="Publishing" Height="44" Margin="0,0,0,8" />
                    <Button Content="Automation" Height="44" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="20,0,0,0" Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="28">
                <StackPanel>
                    <TextBlock Text="Create a quiz" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                    <TextBlock Text="The V2 pipeline is being rebuilt so generation and rendering never freeze the desktop." Margin="0,8,0,24" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,10,0" Padding="18" CornerRadius="10" Background="#263449">
                            <StackPanel>
                                <TextBlock Text="Question Library" Foreground="{StaticResource PrimaryText}" FontSize="17" />
                                <TextBlock Text="Ready for the new SQLite-backed library service." Margin="0,8,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0" Padding="18" CornerRadius="10" Background="#263449">
                            <StackPanel>
                                <TextBlock Text="Rendering Worker" Foreground="{StaticResource PrimaryText}" FontSize="17" />
                                <TextBlock Text="Dedicated STA rendering boundary keeps WPF work away from the UI thread." Margin="0,8,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
