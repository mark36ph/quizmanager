<Window x:Class="QuizManager.Desktop.RenderingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rendering" Width="900" Height="650" Background="{StaticResource PageBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Video Rendering" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
            <TextBlock Text="Turn a generated quiz into a 1280×720 MP4 using the dedicated WPF rendering worker and FFmpeg." Margin="0,6,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,24,0,24" Padding="24" CornerRadius="14" Background="{StaticResource PanelBackground}">
            <StackPanel>
                <TextBlock Text="1. Select a project" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                <ComboBox x:Name="ProjectBox" Margin="0,10,0,22" Height="38" DisplayMemberPath="Name" SelectionChanged="Project_SelectionChanged"/>
                <TextBlock Text="2. FFmpeg executable" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                <DockPanel Margin="0,10,0,22">
                    <Button DockPanel.Dock="Right" Content="Browse…" Width="100" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="FfmpegBox" Height="38" VerticalContentAlignment="Center" Text="ffmpeg.exe"/>
                </DockPanel>
                <TextBlock Text="3. Render" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                <TextBlock x:Name="ProjectInfoText" Margin="0,8,0,14" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                <ProgressBar x:Name="Progress" Height="12" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="{StaticResource SecondaryText}" Text="Ready." TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="110" Height="40" Margin="0,0,10,0" Click="Close_Click"/>
            <Button x:Name="RenderButton" Content="Render MP4" Width="140" Height="40" Click="Render_Click"/>
        </StackPanel>
    </Grid>
</Window>
