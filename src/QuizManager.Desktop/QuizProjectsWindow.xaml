<Window x:Class="QuizManager.Desktop.QuizProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Projects" Width="1220" Height="780" MinWidth="950" MinHeight="620"
        Background="{StaticResource PageBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="New Project" Width="120" Height="40" Click="New_Click" />
                <Button Content="Generate Quiz" Width="130" Height="40" Margin="10,0,0,0" Click="Generate_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Quiz Projects" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                <TextBlock x:Name="StatusText" Margin="0,5,0,0" Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Saved projects" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="4,4,4,12" />
                    <ListBox x:Name="ProjectsList" SelectionChanged="Project_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,6" CornerRadius="8" Background="#263449">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CategoryDisplay}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding QuestionCount, StringFormat={}{0} questions}" Foreground="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Project name" Foreground="{StaticResource SecondaryText}" />
                            <TextBox x:Name="NameText" Margin="0,5,10,0" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Category" Foreground="{StaticResource SecondaryText}" />
                            <ComboBox x:Name="CategoryBox" Margin="0,5,10,0" Height="34" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Questions" Foreground="{StaticResource SecondaryText}" />
                            <TextBox x:Name="CountText" Text="10" Margin="0,5,0,0" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Margin="0,78,0,0">
                            <TextBlock Text="Description" Foreground="{StaticResource SecondaryText}" />
                            <TextBox x:Name="DescriptionText" Margin="0,5,0,0" Height="50" AcceptsReturn="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <CheckBox x:Name="EnabledBox" Content="Enabled" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Content="Save" Width="85" Height="36" Click="Save_Click" />
                            <Button Content="Delete" Width="85" Height="36" Margin="8,0,0,0" Click="Delete_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,16,0,0" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Generated quiz" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                            <TextBlock x:Name="GeneratedStatusText" Margin="0,5,0,14" Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GeneratedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Question}" Foreground="{StaticResource PrimaryText}" FontSize="16" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AnswerA}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding AnswerB}" Margin="0,3,0,0" Foreground="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding AnswerC}" Margin="0,3,0,0" Foreground="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding AnswerD}" Margin="0,3,0,0" Foreground="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding CorrectText}" Margin="0,7,0,0" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
