<Window x:Class="QuizManager.Desktop.QuestionLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Question Library" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Import JSON" Width="110" Height="40" Margin="0,0,8,0" Click="ImportJson_Click" />
                <Button Content="Export JSON" Width="110" Height="40" Margin="0,0,8,0" Click="ExportJson_Click" />
                <Button Content="Add Question" Width="130" Height="40" Click="AddQuestion_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Question Library" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                <TextBlock x:Name="StatusText" Margin="0,5,0,0" Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Width="260" Height="34" VerticalContentAlignment="Center" Padding="8" TextChanged="SearchBox_TextChanged" />
                        <ComboBox x:Name="CategoryBox" Width="190" Height="34" Margin="10,0,0,0" SelectionChanged="CategoryBox_SelectionChanged" />
                    </StackPanel>
                    <DataGrid x:Name="QuestionsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="QuestionsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Question" Binding="{Binding Question}" Width="*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                            <DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="90" />
                            <DataGridTextColumn Header="Used" Binding="{Binding TimesUsed}" Width="60" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Question" Foreground="{StaticResource SecondaryText}" />
                        <TextBox x:Name="QuestionText" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,12" />
                        <TextBlock Text="Answer A" Foreground="{StaticResource SecondaryText}" /><TextBox x:Name="AnswerA" Margin="0,4,0,8" />
                        <TextBlock Text="Answer B" Foreground="{StaticResource SecondaryText}" /><TextBox x:Name="AnswerB" Margin="0,4,0,8" />
                        <TextBlock Text="Answer C" Foreground="{StaticResource SecondaryText}" /><TextBox x:Name="AnswerC" Margin="0,4,0,8" />
                        <TextBlock Text="Answer D" Foreground="{StaticResource SecondaryText}" /><TextBox x:Name="AnswerD" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="Correct:" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="CorrectBox" Width="70" Margin="8,0,0,0"><ComboBoxItem Content="A"/><ComboBoxItem Content="B"/><ComboBoxItem Content="C"/><ComboBoxItem Content="D"/></ComboBox>
                            <TextBlock Text="Category:" Foreground="{StaticResource SecondaryText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <TextBox x:Name="CategoryText" Width="120" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Difficulty:" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="DifficultyBox" Width="100" Margin="8,0,0,0"><ComboBoxItem Content="easy"/><ComboBoxItem Content="medium"/><ComboBoxItem Content="hard"/><ComboBoxItem Content="insane"/></ComboBox>
                            <CheckBox x:Name="EnabledBox" Content="Enabled" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Question Image" Foreground="{StaticResource SecondaryText}" />
                        <Border Height="150" Margin="0,5,0,8" BorderBrush="{StaticResource SecondaryText}" BorderThickness="1" CornerRadius="6">
                            <Image x:Name="ImagePreview" Stretch="Uniform" Margin="6" />
                        </Border>
                        <TextBlock x:Name="ImagePathText" Text="No image selected" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Choose Image" Width="110" Height="34" Click="SelectImage_Click" />
                            <Button Content="Clear Image" Width="100" Height="34" Margin="8,0,0,0" Click="ClearImage_Click" />
                        </StackPanel>
                        <TextBlock Text="Explanation" Foreground="{StaticResource SecondaryText}" /><TextBox x:Name="ExplanationText" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="Source" Foreground="{StaticResource SecondaryText}" /><TextBox x:Name="SourceText" Margin="0,4,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Width="90" Height="38" Click="Save_Click" />
                            <Button Content="New" Width="90" Height="38" Margin="8,0,0,0" Click="New_Click" />
                            <Button Content="Delete" Width="90" Height="38" Margin="8,0,0,0" Click="Delete_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
